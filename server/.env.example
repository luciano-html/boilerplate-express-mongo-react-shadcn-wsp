# ============================================================
# El bot de WhatsApp arranca APAGADO. Para habilitarlo en esta
# instalacion, poner en true. Sin esto no se conecta ni aunque
# el toggle del admin este prendido.
# WHATSAPP_BOT_ENABLED=true
# ============================================================

PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/stock-office-center

# Seguridad: generar con openssl rand -base64 32
JWT_SECRET=change-this-secret
REFRESH_TOKEN_SECRET=change-this-refresh-secret

# CORS: separar orígenes con comas. Ej: http://localhost:5173,https://miapp.com
CORS_ORIGINS=http://localhost:5173

# Cookies: en producción poner secure=true y sameSite=strict
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allowlist de CLIENTES del bot. No es la linea del bot (esa se define
# escaneando el QR): son los numeros con los que tiene permitido hablar.
# Filtra tanto lo que responde como lo que envia (confirmaciones de pedido).
# Vacia o ausente = sin restriccion, le habla a cualquiera.
# Dejala seteada mientras testees sobre una linea real.
# WHATSAPP_ALLOWED_NUMBERS=5493425661254

# LOG_LEVEL=debug para ver las renovaciones del QR y los mensajes descartados.
# LOG_LEVEL=info

# Ventana de gracia (segundos) para mensajes que llegan tras una RECONEXION.
# Tras un escaneo de QR no aplica: ahi se descarta todo el backlog sin excepcion.
# WHATSAPP_MAX_MESSAGE_AGE_SECONDS=600
